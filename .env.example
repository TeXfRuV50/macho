# Discord Bot Token (lấy từ Discord Developer Portal -> Bot -> Token)
DISCORD_TOKEN=your_bot_token_here

# Discord Client / Application ID (lấy từ Discord Developer Portal -> General Information)
CLIENT_ID=your_client_id_here

# (Tùy chọn) Guild ID để test slash command tức thì trong một server cụ thể thay vì chờ global command sync
# GUILD_ID=1546872660355457135

# Đường dẫn file SQLite database
DATABASE_PATH=./werewolf.db

# Chế độ debug log (true/false)
DEBUG=false
